# ============================================================
# Copia este archivo a ".env" en la raiz y ajusta los valores.
# Docker Compose lee ".env" para la substitucion de variables.
# ============================================================

# Credenciales de PostgreSQL (el contenedor postgres las usa para crear la BD)
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave
DB_NAME=siga_suiza_2026

# Desde los contenedores, la BD por defecto es el servicio "postgres".
# Para usar la PostgreSQL del host en su lugar: SIGA_DB_HOST=host.docker.internal
SIGA_DB_HOST=postgres
SIGA_DB_PORT=5432

# Puertos expuestos al host
POSTGRES_HOST_PORT=5433
FRONTEND_PORT=5173

# Firma de los tokens JWT (cambiar en despliegues reales)
SECRET_KEY=change-me-in-production

# ============================================================
# RENDER - Web Service (solo variables, SIN valores secretos)
# ============================================================
# Render inyecta DATABASE_URL con la conexión del PostgreSQL administrado.
# Si no se define, se usan DB_USER/DB_PASSWORD/DB_NAME/DB_HOST/DB_PORT (solo desarrollo).
DATABASE_URL=
# Render: DB_SSLMODE=require. El sslmode de DATABASE_URL tiene prioridad sobre esta variable.
DB_SSLMODE=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=180
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_URL=
# Lista separada por comas; en Render: https://siga-frontend-pkpc.onrender.com
CORS_ORIGINS=
# Render: false. true requiere un servicio NATS real accesible por NATS_URL.
ENABLE_NATS=false
NATS_URL=nats://localhost:4222
# Render: true para no ejecutar Alembic en el arranque.
SKIP_MIGRATIONS=false
# Render: true para ejecutar los módulos dentro del mismo proceso Uvicorn.
SIGA_SINGLE_PROCESS=true
PROGRAMAS_MODULE_URL=http://127.0.0.1:8005
PLANES_MODULE_URL=http://127.0.0.1:8002

# ============================================================
# RENDER - Static Site (valores se leen en el build de Vite)
# ============================================================
VITE_API_URL=
# Render: https://siga-backend-pog5.onrender.com (absoluta, HTTPS, sin barra final; requiere rebuild).
VITE_WS_URL=
# Omitir en Render, o wss://siga-backend-pog5.onrender.com sin sufijo /ws.

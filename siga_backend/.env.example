# Copiar a .env y completar. NUNCA subir el .env real.
APP_NAME=SIGA Core
ENVIRONMENT=production
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
DEBUG=False

# Railway inyecta DATABASE_URL automaticamente al conectar PostgreSQL.
# DATABASE_URL=postgresql://usuario:password@host:5432/base
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar
DB_NAME=siga_suiza_2026

MODULES_AUTO_DISCOVER=True
MODULES_VALIDATE_ON_START=True

# Sin complementos NATS/Redis en Railway, mantener en False.
ENABLE_NATS=False
NATS_URL=nats://localhost:4222
CACHE_ENABLED=False
